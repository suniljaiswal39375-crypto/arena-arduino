  "files": {
    "sketch.ino": "// Serial command console: type \"on\" or \"off\" in the monitor.\nString command = \"\";\n\nvoid setup() {\n  pinMode(13, OUTPUT);\n  Serial.begin(9600);\n  Serial.println(\"ready\");\n}\n\nvoid loop() {\n  while (Serial.available() > 0) {\n    char c = Serial.read();\n    if (c == '\\n') {\n      command.trim();\n      if (command == \"on\") {\n        digitalWrite(13, HIGH);\n        Serial.println(\"LED on\");\n      } else if (command == \"off\") {\n        digitalWrite(13, LOW);\n        Serial.println(\"LED off\");\n      } else {\n        Serial.println(\"unknown command\");\n      }\n      command = \"\";\n    } else {\n      command += c;\n    }\n  }\n}\n",
