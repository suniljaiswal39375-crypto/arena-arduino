  "files": {
    "sketch.ino": "const int buttonPin = 2;\nconst int ledPin = 13;\n\nvoid setup() {\n  pinMode(buttonPin, INPUT_PULLUP);\n  pinMode(ledPin, OUTPUT);\n}\n\nvoid loop() {\n  // Pressed reads LOW because INPUT_PULLUP holds the pin HIGH.\n  digitalWrite(ledPin, digitalRead(buttonPin) == LOW ? HIGH : LOW);\n}\n",
