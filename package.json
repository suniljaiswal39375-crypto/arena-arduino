{
  "name": "sparklab",
  "version": "0.1.0",
  "private": true,
  "description": "SparkLab - a browser electronics lab that fuses guided ATL-style learning with real firmware emulation",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "vite-node --config vitest.config.ts scripts/sparklab-cli.ts --",
    "scenarios": "vite-node --config vitest.config.ts scripts/sparklab-cli.ts -- test examples --recursive",
    "examples": "vite-node --config vitest.config.ts scripts/generate-examples.ts",
    "predev": "node scripts/prepare-editor.mjs",
    "prebuild": "node scripts/prepare-editor.mjs",
    "postbuild": "node scripts/prepare-offline.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vite-node": "3.2.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
