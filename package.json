{
  "name": "sparklab",
  "version": "0.1.0",
  "private": true,
  "description": "SparkLab - a browser electronics lab that fuses guided ATL-style learning with real firmware emulation",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "vite-node --config vitest.config.ts scripts/sparklab-cli.ts --",
    "scenarios": "vite-node --config vitest.config.ts scripts/sparklab-cli.ts -- test examples --recursive",
    "examples": "vite-node --config vitest.config.ts scripts/generate-examples.ts",
    "predev": "node scripts/prepare-editor.mjs",
    "prebuild": "node scripts/prepare-editor.mjs",
    "postbuild": "node scripts/prepare-offline.mjs && npm run budget",
    "test:e2e": "playwright test",
    "budget": "vite-node --config vitest.config.ts scripts/budget.ts",
    "db:migrate": "node scripts/classroom-admin.mjs migrate",
    "db:role": "node scripts/classroom-admin.mjs role",
    "firmware:farm": "vite-node --config vitest.config.ts scripts/firmware-build-farm.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.8.1",
    "avr8js": "^0.21.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "immer": "^10.1.1",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.0.9",
    "next": "^15.1.6",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.6.0",
    "three": "^0.186.1",
    "yaml": "^2.9.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "8.16.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vite-node": "3.2.4",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
