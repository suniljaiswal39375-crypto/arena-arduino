# ---------------------------------------------------------------------------
# SparkLab environment
#
# Nothing here is required to run the app locally: the builder, the simulator,
# the missions and the skills all run with zero configuration. These variables
# only matter once you turn on the server-backed features (accounts,
# classrooms, sharing, the firmware build farm and the AI mentor).
#
# Copy to .env.local and fill in what you need.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=SparkLab

# --- Database (Postgres, Neon or Supabase) ---------------------------------
# Only needed for accounts, classrooms and saved projects.
DATABASE_URL=postgres://user:password@host:5432/sparklab?sslmode=require
# Set when using Supabase's pooled connection on serverless.
DIRECT_URL=

# --- Redis (Upstash) -------------------------------------------------------
# Rate limiting, build-queue dedupe and classroom presence.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only opt-in; public feature flags below do not enable classroom APIs.
SPARKLAB_CLASSROOMS_ENABLED=false

# --- Auth.js ---------------------------------------------------------------
# Generate locally: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Reserved: magic-link sign-in is not implemented yet.
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=SparkLab <no-reply@example.com>

# --- Object storage (S3 compatible) ---------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sparklab
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_PUBLIC_URL=

# --- Firmware build farm --------------------------------------------------
# Where the compile workers live; local docker-compose by default.
BUILD_FARM_URL=http://localhost:8080
BUILD_FARM_TOKEN=
# Artifact cache TTL in seconds (sha256 keyed by sketch + libraries + fqbn).
BUILD_CACHE_TTL_SECONDS=604800

# --- AI mentor (Saksham) --------------------------------------------------
# The mentor calls typed tools into the simulator; it never free-forms.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard ceiling per student per hour, in tool calls.
MENTOR_RATE_LIMIT_PER_HOUR=60

# --- Observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_SENTRY_DSN=

# --- Feature flags --------------------------------------------------------
# Keep these off until the backing service is configured.
NEXT_PUBLIC_FEATURE_ACCOUNTS=false
NEXT_PUBLIC_FEATURE_CLASSROOMS=false
NEXT_PUBLIC_FEATURE_FIRMWARE_EMULATOR=false
NEXT_PUBLIC_FEATURE_MENTOR=false
NEXT_PUBLIC_FEATURE_MULTIPLAYER=false
