# ---------------------------------------------------------------------------
# SparkLab environment
#
# Nothing here is required to run the app locally: the builder, the simulator,
# the missions and the skills all run with zero configuration. These variables
# only matter once you turn on the server-backed features (accounts,
# classrooms, sharing, the firmware build farm and the AI mentor).
#
# Copy to .env.local and fill in what you need.
# ---------------------------------------------------------------------------

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PRODUCT_NAME=SparkLab

# --- Database (Postgres, Neon or Supabase) ---------------------------------
# Only needed for accounts, classrooms and saved projects.
DATABASE_URL=postgres://user:password@host:5432/sparklab?sslmode=require
# Set when using Supabase's pooled connection on serverless.
DIRECT_URL=

# --- Redis (Upstash) -------------------------------------------------------
# Rate limiting, build-queue dedupe and classroom presence.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only opt-in; public feature flags below do not enable classroom APIs.
SPARKLAB_CLASSROOMS_ENABLED=false

# --- Firmware compiler (arduino-cli) --------------------------------------
# Path to an arduino-cli 1.x binary for the AVR compile service. When unset,
# the firmware engine still runs pre-built Intel HEX images; a missing install
# is reported honestly rather than faked.
SPARKLAB_ARDUINO_CLI=
# Optional bounds for the compile service (milliseconds). Defaults 5000/20000.
# SPARKLAB_FW_HEARTBEAT_MS=5000
# SPARKLAB_FW_COMPILE_MS=20000

# --- Auth.js ---------------------------------------------------------------
# Generate locally: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Reserved: magic-link sign-in is not implemented yet.
EMAIL_SERVER=smtp://user:password@smtp.example.com:587
EMAIL_FROM=SparkLab <no-reply@example.com>

# --- Object storage (S3 compatible) ---------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=sparklab
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_S3_PUBLIC_URL=

# --- Firmware build farm --------------------------------------------------
# Where the compile workers live; local docker-compose by default.
BUILD_FARM_URL=http://localhost:8080
BUILD_FARM_TOKEN=
# Artifact cache TTL in seconds (sha256 keyed by sketch + libraries + fqbn).
BUILD_CACHE_TTL_SECONDS=604800

# --- AI mentor (Saksham) --------------------------------------------------
# The mentor calls typed tools into the simulator; it never free-forms.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Hard ceiling per student per hour, in tool calls.
MENTOR_RATE_LIMIT_PER_HOUR=60

# --- Observability --------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_SENTRY_DSN=

# --- Hosted MCP (spec 12.7) ----------------------------------------------
# POST /api/mcp stays disabled until a token is set. Local agents should use
# `sparklab-cli mcp` on stdio instead (no server, no token). The root confines
# every path argument the token holder may touch.
# SPARKLAB_CLI_TOKEN=
# SPARKLAB_MCP_ROOT=./projects

# --- Firebase (Auth + Firestore + Storage) — Vercel deployment --------------
# Preferred auth/storage for Vercel. All NEXT_PUBLIC_ vars are exposed to the browser.
# Get these from Firebase Console > Project Settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Optional: use local Firebase emulators during development
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=false
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# Server-only Firebase Admin SDK (for verifying ID tokens and privileged ops)
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_ADMIN_STORAGE_BUCKET=

# --- Feature flags --------------------------------------------------------
# Keep these off until the backing service is configured.
NEXT_PUBLIC_FEATURE_ACCOUNTS=false
NEXT_PUBLIC_FEATURE_CLASSROOMS=false
NEXT_PUBLIC_FEATURE_FIRMWARE_EMULATOR=false
NEXT_PUBLIC_FEATURE_MENTOR=false
NEXT_PUBLIC_FEATURE_MULTIPLAYER=false
# Firebase-backed features (Vercel)
NEXT_PUBLIC_FEATURE_FIREBASE_AUTH=false
NEXT_PUBLIC_FEATURE_FIREBASE_STORAGE=false

# --- Co-Lab relay (multiplayer server rooms) ----------------------------
# Rooms that span devices need a relay. Run it locally with `npm run
# collab:relay` (memory-only: a restart clears every room; no accounts, no
# persistence). Point the builder at it to offer the "Server room" option.
# NEXT_PUBLIC_COLLAB_WS_URL=ws://localhost:8787
# SPARKLAB_COLLAB_PORT=8787
# SPARKLAB_COLLAB_HOST=0.0.0.0
